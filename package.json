{
  "name": "pdf-exporter",
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/google-apps-script": "^2.0.13",
    "eslint": "^10.11.0",
    "eslint-plugin-googleappsscript": "^1.0.5",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "lint": "eslint",
    "typecheck": "tsc -p jsconfig.json",
